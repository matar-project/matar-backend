model User {
  id            Int            @id @default(autoincrement())
  name          String
  email         String         @unique
  phone         String?
  country       String?
  city          String?
  passwordHash  String
  roleId        Int
  role          Role           @relation(fields: [roleId], references: [id])
  refreshTokens RefreshToken[]
  createdRequests Request[]        @relation("CreatedRequests")
  coordinatedRequests Request[]    @relation("CoordinatedRequests")
  pageReservations PageReservation[] @relation("VolunteerReservations")
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([roleId])
}
