enum LibraryItemType {
  AUDIO
  WORD_DOC
  PDF
  BRAILLE
  OTHER
}

model LibraryItem {
  id          Int             @id @default(autoincrement())
  title       String
  author      String?
  subject     String?
  curriculum  String?
  country     String?
  description String?
  itemType    LibraryItemType
  fileUrl     String
  fileName    String
  fileSize    Int?
  published   Boolean         @default(true)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
}
