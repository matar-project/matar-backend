model Volunteer {
  id               Int      @id @default(autoincrement())
  name             String
  phone            String
  email            String?
  country          String?
  city             String
  interests        String[]
  preferredContact String
  contacted        Boolean  @default(false)
  notes            String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}
