DATABASE_URL="postgresql://user:password@localhost:5432/matar_db"
JWT_ACCESS_SECRET="change-me-access-secret-32-chars-min"
JWT_REFRESH_SECRET="change-me-refresh-secret-32-chars-min"
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=604800
FRONTEND_URL="http://localhost:5173"
PORT=3000
# Email delivery via Resend (https://resend.com)
RESEND_API_KEY="re_your_api_key"
# Leave as the shared test sender until you verify a domain in Resend.
RESEND_FROM="Matar <onboarding@resend.dev>"
